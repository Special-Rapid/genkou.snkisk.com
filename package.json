{
  "name": "kantan-snkisk-com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:brand-assets": "node scripts/generate-brand-assets.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "prepare:favicon": "node scripts/prepare-favicon.mjs",
    "prebuild": "npm run prepare:favicon",
    "predev": "npm run prepare:favicon",
    "pretest": "npm run prepare:favicon"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.0"
  }
}
