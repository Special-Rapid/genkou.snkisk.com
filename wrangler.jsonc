{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kantan-snkisk-com",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/index.html", "/ja", "/ja/*", "/en", "/en/*", "/docs", "/robots.txt", "/sitemap.xml"]
  },
  "routes": [
    {
      "pattern": "genkou.snkisk.com",
      "custom_domain": true
    },
    {
      "pattern": "docs.genkou.snkisk.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
